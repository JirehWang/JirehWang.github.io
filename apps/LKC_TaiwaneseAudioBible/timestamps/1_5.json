{
  "bid": 1,
  "chap": 5,
  "title": "創世記第5章",
  "audio_version": "1",
  "total_duration": 194.48,
  "verses": [
    {
      "sec": 1,
      "start": 2.43,
      "end": 11.74,
      "text": "亞當的世系記佇下底。（當上帝創造人的日，是照上帝的款式來造伊，"
    },
    {
      "sec": 2,
      "start": 11.74,
      "end": 18.98,
      "text": "創造𪜶查甫及查某。佇𪜶受創造的日，賜𪜶福氣，稱𪜶的名叫「人」。）"
    },
    {
      "sec": 3,
      "start": 18.98,
      "end": 26.57,
      "text": "亞當一百三十歲生子，照伊的款親像伊的像，標名叫設。"
    },
    {
      "sec": 4,
      "start": 26.57,
      "end": 33.81,
      "text": "亞當生設了後，閣歷過八百年，其中猶(iáu)有生子查某子。"
    },
    {
      "sec": 5,
      "start": 33.81,
      "end": 38.29,
      "text": "亞當計共享壽九百三十歲才死。"
    },
    {
      "sec": 6,
      "start": 38.29,
      "end": 41.74,
      "text": "設一百連五歲，生以羅士。"
    },
    {
      "sec": 7,
      "start": 41.74,
      "end": 50.01,
      "text": "設生以羅士的了後，猶活八百連七年，其中有閣生子查某子。"
    },
    {
      "sec": 8,
      "start": 50.01,
      "end": 54.49,
      "text": "設計共享壽九百一十二歲才死。"
    },
    {
      "sec": 9,
      "start": 54.49,
      "end": 57.6,
      "text": "以羅士九十歲，生該南。"
    },
    {
      "sec": 10,
      "start": 57.6,
      "end": 66.56,
      "text": "以羅士生該南的了後，猶活八百一十五年，其中有閣生子查某子。"
    },
    {
      "sec": 11,
      "start": 66.56,
      "end": 71.39,
      "text": "以羅士計共享壽九百連五歲才死。"
    },
    {
      "sec": 12,
      "start": 71.39,
      "end": 74.49,
      "text": "該南七十歲，生瑪勒列。"
    },
    {
      "sec": 13,
      "start": 74.49,
      "end": 83.11,
      "text": "該南生瑪勒列的了後，猶活八百四十年，其中有閣生子查某子。"
    },
    {
      "sec": 14,
      "start": 83.11,
      "end": 87.59,
      "text": "該南計共享壽九百一十歲才死。"
    },
    {
      "sec": 15,
      "start": 87.59,
      "end": 91.04,
      "text": "瑪勒列六十五歲，生雅列。"
    },
    {
      "sec": 16,
      "start": 91.04,
      "end": 99.66,
      "text": "瑪勒列生雅列的了後，猶活八百三十年，其中有閣生子查某子。"
    },
    {
      "sec": 17,
      "start": 99.66,
      "end": 104.83,
      "text": "瑪勒列計共享壽八百九十五歲才死。"
    },
    {
      "sec": 18,
      "start": 104.83,
      "end": 108.63,
      "text": "雅列一百六十二歲，生以諾。"
    },
    {
      "sec": 19,
      "start": 108.63,
      "end": 116.21,
      "text": "雅列生以諾的了後，猶活八百年，其中有閣生子查某子。"
    },
    {
      "sec": 20,
      "start": 116.21,
      "end": 121.04,
      "text": "雅列計共享壽九百六十二歲才死。"
    },
    {
      "sec": 21,
      "start": 121.04,
      "end": 124.83,
      "text": "以諾六十五歲，生瑪土撒拉。"
    },
    {
      "sec": 22,
      "start": 124.83,
      "end": 134.49,
      "text": "以諾生瑪土撒拉的了後，及上帝相及行三百年，其中有閣生子查某子。"
    },
    {
      "sec": 23,
      "start": 134.49,
      "end": 138.62,
      "text": "以諾計共享壽三百六十五歲。"
    },
    {
      "sec": 24,
      "start": 138.62,
      "end": 144.83,
      "text": "以諾及上帝相及行，上帝接伊去，伊就無佇啲。"
    },
    {
      "sec": 25,
      "start": 144.83,
      "end": 149.31,
      "text": "瑪土撒拉一百八十七歲，生拉麥。"
    },
    {
      "sec": 26,
      "start": 149.31,
      "end": 158.62,
      "text": "瑪土撒拉生拉麥的了後，猶活七百八十二年，其中有閣生子查某子。"
    },
    {
      "sec": 27,
      "start": 158.62,
      "end": 164.14,
      "text": "瑪土撒拉計共享壽九百六十九歲才死。"
    },
    {
      "sec": 28,
      "start": 164.14,
      "end": 168.28,
      "text": "拉麥一百八十二歲，生一個子，"
    },
    {
      "sec": 29,
      "start": 168.28,
      "end": 177.59,
      "text": "標名叫挪亞，講：「耶和華曾咒詛地，互咱做工勞苦；今此個子欲安慰咱。」"
    },
    {
      "sec": 30,
      "start": 177.59,
      "end": 186.2,
      "text": "拉麥生挪亞的了後，猶活五百九十五年，其中有閣生子查某子。"
    },
    {
      "sec": 31,
      "start": 186.2,
      "end": 191.03,
      "text": "拉麥計共享壽七百七十七歲才死。"
    },
    {
      "sec": 32,
      "start": 191.03,
      "end": 194.48,
      "text": "挪亞五百歲生閃、含、雅弗。"
    }
  ]
}
