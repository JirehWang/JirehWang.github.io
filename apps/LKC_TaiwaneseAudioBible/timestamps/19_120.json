{
  "bid": 19,
  "chap": 120,
  "title": "詩篇 第120篇",
  "audio_version": "1",
  "total_duration": 46.52,
  "verses": [
    {
      "sec": 1,
      "start": 0.0,
      "end": 10.62,
      "text": "〔上崎仔的詩。〕我佇危急中(gûi-kip-tiong)求叫耶和華，伊就應我。"
    },
    {
      "sec": 2,
      "start": 10.62,
      "end": 17.13,
      "text": "耶和華啊，求你救我脫離白賊的嘴唇，及詭詐的舌！"
    },
    {
      "sec": 3,
      "start": 17.13,
      "end": 23.81,
      "text": "詭詐的舌啊，主欲互你甚麼啊？欲用甚麼加添互你啊！"
    },
    {
      "sec": 4,
      "start": 23.81,
      "end": 28.35,
      "text": "就是勇猛的人的利箭及羅騰柴的熱炭。"
    },
    {
      "sec": 5,
      "start": 28.35,
      "end": 35.45,
      "text": "我真慘啊！寄腳佇<u>米設</u>，徛起佇<u>基達</u>許個布棚的中間。"
    },
    {
      "sec": 6,
      "start": 35.45,
      "end": 40.31,
      "text": "我及許個怨恨和平的人久久相及徛起。"
    },
    {
      "sec": 7,
      "start": 40.31,
      "end": 46.52,
      "text": "我愛和平，總是我開嘴，𪜶就欲爭戰。"
    }
  ]
}
